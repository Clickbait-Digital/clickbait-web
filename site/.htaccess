# Clickbait Digital — sunucu ayarları

DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# --- HTTPS ve www'suz adrese yönlendirme ---
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://clickbait.com.tr%{REQUEST_URI} [L,R=301]

# --- Eski sitenin adreslerini yeni bölümlere yönlendir (Google sıralaması korunur) ---
RewriteRule ^ajansimiz/?$ /#hakkimizda [R=301,L,NE]
RewriteRule ^our_services/web-tasarim/?$ /web-tasarim/ [R=301,L]
RewriteRule ^our_services/e-ticaret/?$ /ankara-e-ticaret-sitesi/ [R=301,L]
RewriteRule ^our_services/digital-medya/?$ /dijital-pazarlama/ [R=301,L]
RewriteRule ^our_services/kreatif-hizmetler/?$ /kreatif-hizmetler/ [R=301,L]
RewriteRule ^our_services/.*$ /#hizmetler [R=301,L,NE]
RewriteRule ^saglik-turizmi-reklamlari/?$ /dijital-pazarlama/ [R=301,L]
RewriteRule ^ankara-web-tasarim/?$ /web-tasarim/ [R=301,L]
RewriteRule ^referanslarimiz/?$ /#projeler [R=301,L,NE]
RewriteRule ^iletisim/?$ /#iletisim [R=301,L,NE]
</IfModule>

# --- Sıkıştırma ---
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

# --- Önbellek: HTML/CSS/JS her ziyarette kontrol edilir, değişiklikler hemen görünür ---
<IfModule mod_headers.c>
<FilesMatch "\.(html|css|js)$">
Header set Cache-Control "no-cache"
</FilesMatch>
<FilesMatch "\.(svg|png|jpe?g|webp|gif|ico|woff2?)$">
Header set Cache-Control "public, max-age=604800"
</FilesMatch>
</IfModule>
